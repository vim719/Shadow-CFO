# ============================================================================
# Shadow CFO — Environment Variables TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to GitHub!
# ============================================================================

# Plaid API Credentials
# Get these from: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox  # sandbox | development | production

# Supabase Credentials
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe (for subscriptions)
# Get these from: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Claude API (for AI coaching engine)
# Get these from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_claude_api_key_here

# 0G Galileo Testnet Configuration
# Enable the 0G integration scaffold
ZERO_G_ENABLED=true

# 0G Network Endpoints (Galileo Testnet)
OG_EVM_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai
OG_INDEXER_RPC_URL=https://indexer-storage-testnet.0g.ai
OG_FLOW_RPC_URL=https://rpc-storage-testnet.0g.ai
OG_DA_RPC_URL=https://disperser-testnet.0g.ai

# AES-256 Encryption Key (MUST BE EXACTLY 64 HEX CHARS)
ZERO_G_ENCRYPTION_KEY=your_64_char_hex_key_here

# 0G Sponsor Wallet (for storage upload fees)
# Local dev: set in .env; Production: stored in Supabase Vault
# ZERO_G_SPONSOR_PRIVATE_KEY=your_wallet_private_key
